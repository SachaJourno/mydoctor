{
  "expo": {
    "name": "MyDoctor",
    "slug": "mydoctor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.mydoctor.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fr.mydoctor.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "scheme": "mydoctor",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {}
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "MyDoctor utilise l’appareil photo pour photographier une ordonnance.",
          "photosPermission": "MyDoctor accède à vos photos pour importer une ordonnance."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
